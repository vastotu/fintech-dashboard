# Supabase config
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# External APIs
NEWSAPI_KEY=your_newsapi_key_here
GEMINI_API_KEY=your_gemini_key_here

# CORS allow-list for the deployed frontend.
# Comma-separated for multiple origins (production domain + preview URLs).
# Defaults to http://localhost:3000 when unset. "*" is not usable here, since
# credentialed requests require explicitly named origins.
FRONTEND_URL=http://localhost:3000
