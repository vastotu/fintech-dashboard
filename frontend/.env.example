# Base URL of the FastAPI backend, with no trailing slash.
#
# Must be NEXT_PUBLIC_ prefixed: it is read in a client component, so Next.js
# inlines it into the browser bundle at BUILD time. Changing it in Vercel
# therefore requires a redeploy -- editing the variable alone will not fix an
# already-built deployment.
#
# NEXT_PUBLIC_API_BASE is still accepted as an alias if you already have it
# set locally, but prefer NEXT_PUBLIC_API_URL.
#
# Local:      http://localhost:8000
# Deployed:   https://<your-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
